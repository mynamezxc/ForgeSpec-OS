{
  "name": "ForgeSpec OS",
  "full_name": "ForgeSpec OS \u2014 Production Engineering & Agent Execution Standard",
  "version": "1.3.0",
  "public_readme": "README.md",
  "agent_entrypoint": "AGENT_ENTRYPOINT.md",
  "product_spec_entrypoint": "PRODUCT_SPEC_ENTRYPOINT.md",
  "principle": "ForgeSpec OS defines how engineering work is executed; Product SPEC defines what the product must become.",
  "task_states": [
    "NOT_STARTED",
    "READY",
    "IN_PROGRESS",
    "BLOCKED",
    "VERIFYING",
    "DONE"
  ],
  "release_states": [
    "NOT_RELEASE_READY",
    "RELEASE_CANDIDATE",
    "PRODUCTION_READY"
  ],
  "done_requires_evidence": true,
  "ui_only_is_not_production_complete": true,
  "required_behavior_cannot_end_as_hardcoded_mock_or_stub": true,
  "context_checkpoint_required_before_compression": true,
  "subagent_return_requires_evidence": true,
  "main_agent_retains_integration_authority": true,
  "product_specific_rules_must_not_pollute_global_scope": true,
  "test_cadence": {
    "targeted": "after relevant changes",
    "integration": "after a coherent task or contract boundary",
    "e2e": "after 3-7 meaningful tasks or immediately after a high-risk change",
    "full": "at the applicable release gate"
  },
  "planning_rule": "Plan until the next safe executable action is clear, then implement.",
  "completion_audit_required": true,
  "skill_system": {
    "router": "07_SKILLS/01_SKILL_ROUTER.md",
    "external_skill_security_gate_required": true,
    "external_providers_are_optional": true,
    "pin_external_skills_for_reproducibility": true,
    "skill_output_requires_verification": true,
    "product_spec_overrides_skill_style_preferences": true,
    "active_security_scanning_requires_authorized_scope": true,
    "preload_full_skill_catalog": false
  }
}
